---
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

export async function getStaticPaths() {
  const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
  return guides.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: guides[index - 1], next: guides[index + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const sourceUrl = `https://github.com/nanohype/nanohype/blob/main/docs/${entry.data.file}`;
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description: entry.data.description,
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 3 },
  }}
>
  <Content />

  <nav class="pager">
    {
      previous ? (
        <a class="pager-link" href={`/building/${previous.id}/`}>
          <span class="pager-label">Previous</span>
          <span>{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="pager-link next" href={`/building/${next.id}/`}>
          <span class="pager-label">Next</span>
          <span>{next.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <p class="source">
    Maintained in the catalog repo as <a href={sourceUrl}><code>docs/{entry.data.file}</code></a>
    and rendered here from it.
  </p>
</StarlightPage>

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2.5rem;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .pager-link:hover {
    border-color: var(--sl-color-accent);
  }
  .pager-link.next {
    text-align: end;
  }
  .pager-label {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .source {
    margin-block-start: 2rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
