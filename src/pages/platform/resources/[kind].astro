---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import SchemaFields from "../../../components/SchemaFields.astro";
import {
  listPlatformResources,
  type PlatformResource,
  resourceSlug,
} from "../../../lib/resources.ts";

export async function getStaticPaths() {
  const resources = await listPlatformResources();
  return resources.map((resource) => ({
    params: { kind: resourceSlug(resource) },
    props: { resource },
  }));
}

interface Props {
  resource: PlatformResource;
}

const { resource } = Astro.props;
const apiVersion = `${resource.group}/${resource.versions[0]}`;
---

<StarlightPage
  frontmatter={{
    title: resource.kind,
    description: resource.description || `The ${resource.kind} custom resource.`,
    tableOfContents: false,
  }}
>
  <dl class="meta">
    <div>
      <dt>apiVersion</dt>
      <dd><code>{apiVersion}</code></dd>
    </div>
    <div>
      <dt>kind</dt>
      <dd><code>{resource.kind}</code></dd>
    </div>
    <div>
      <dt>scope</dt>
      <dd>{resource.scope}</dd>
    </div>
    <div>
      <dt>reconciled by</dt>
      <dd><a href={`/repos/${resource.repo}/`}>{resource.repo}</a></dd>
    </div>
    {
      resource.shortNames.length > 0 ? (
        <div>
          <dt>short names</dt>
          <dd>
            {resource.shortNames.map((name, index) => (
              <>
                {index > 0 ? <span aria-hidden="true">, </span> : null}
                <code>{name}</code>
              </>
            ))}
          </dd>
        </div>
      ) : null
    }
  </dl>

  {resource.description ? <p>{resource.description}</p> : null}
  {
    resource.specDescription && resource.specDescription !== resource.description ? (
      <p>{resource.specDescription}</p>
    ) : null
  }

  {
    resource.printerColumns.length > 0 ? (
      <>
        <h2 id="kubectl">What <code>kubectl get</code> shows</h2>
        <table>
          <thead>
            <tr>
              <th>Column</th>
              <th>Type</th>
              <th>Meaning</th>
            </tr>
          </thead>
          <tbody>
            {resource.printerColumns.map((column) => (
              <tr>
                <td>
                  <code>{column.name}</code>
                </td>
                <td>{column.type}</td>
                <td>{column.description ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ) : null
  }

  <h2 id="spec">Spec</h2>
  <SchemaFields fields={resource.spec} />
</StarlightPage>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    margin: 0 0 1.5rem;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta dt {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .meta dd {
    margin: 0;
  }

  table {
    display: table;
    width: 100%;
  }
</style>
