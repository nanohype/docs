node_modules
dist
.astro
.DS_Store

# Where CI checks the catalog, the atlas and the platform and fleet API
# definitions out so the generated reference, the /atlas/ pages and the
# /platform/resources/ reference can be built. Locally the build reads the
# sibling checkouts instead and never creates these. Ignoring them also keeps
# them out of `biome check`, which reads .gitignore: they are other repos'
# files, formatted to those repos' rules.
.org/
.atlas/
.platform/
.fleet/

# OpenTofu / Terragrunt
.terragrunt-cache
.terraform
*.tfstate
*.tfstate.*

# Working notes. Planning state, campaign status, and remediation ledgers stay
# out of the repo — a published record of what a repo scored and how it got
# fixed is the accretion evidence the greenfield doctrine exists to prevent.
.plans/

# Diagrams copied in from the atlas emit during prebuild — see scripts/sync-atlas.ts.
public/atlas/
